            function checkExpiredLimits() {
                const now = new Date();
                const todayEnd = new Date();
                todayEnd.setHours(23, 59, 59, 999); // Set to today at 23:59:59.999

                document.querySelectorAll('.info-table tbody tr').forEach(row => {
                    const expiryCell = row.querySelector('td:nth-child(3)');
                    const statusCell = row.querySelector('td:nth-child(4)');

                    if (expiryCell && statusCell) {
                        const expiryText = expiryCell.textContent.trim();
                        if (expiryText !== 'N/A') {
                            const expiryDate = new Date(expiryText + 'T23:59:59');

                            if (expiryDate <= todayEnd) {
                                // Update status to Expired
                                const statusBadge = statusCell.querySelector('.status-badge');
                                if (statusBadge) {
                                    // Remove all existing status classes
                                    statusBadge.className = 'status-badge status-expired';
                                    statusBadge.textContent = 'Expired';

                                    // Make AJAX call to update server status
                                    updateStatusOnServer(row);
                                }
                            }
                        }
                    }
                });
            }

            function updateStatusOnServer(row) {
                // Extract the credit limit ID from the edit link
                const editLink = row.querySelector('.edit-link');
                if (!editLink) return;

                const href = editLink.getAttribute('href');
                const match = href.match(/limitId=(\d+)/);
                if (!match) return;

                const limitId = match[1];

                // Send AJAX request to update status
                fetch('{{ path("credit_limit_update_status", {'id': merchant.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        id: limitId,
                        status: 'Expired'
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            console.error('Failed to update status:', data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error updating status:', error);
                    });
            }

            function setDateRange(range) {
                const today = new Date();
                let startDate, endDate;

                switch(range) {
                    case 'today':
                        startDate = new Date(today);
                        endDate = new Date(today);
                        break;
                    case 'week':
                        startDate = new Date(today);
                        startDate.setDate(today.getDate() - 6);
                        endDate = new Date(today);
                        break;
                    case 'month':
                        startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                        endDate = new Date(today);
                        break;
                }

                const formattedStart = formatDate(startDate);
                const formattedEnd = formatDate(endDate);

                const dateRangeDisplay = document.getElementById('dateRangeDisplay');
                if (dateRangeDisplay) {
                    dateRangeDisplay.textContent = formattedStart === formattedEnd
                        ? formattedStart
                        : `${formattedStart} - ${formattedEnd}`;
                }
            }

            function formatDate(date) {
                const options = {
                    month: 'long',
                    day: 'numeric',
                    year: date.getMonth() !== new Date().getMonth() ? 'numeric' : undefined
                };

                let formatted = date.toLocaleDateString('en-US', options);
                const day = date.getDate();
                const suffix = (day % 10 === 1 && day !== 11) ? 'st' :
                    (day % 10 === 2 && day !== 12) ? 'nd' :
                        (day % 10 === 3 && day !== 13) ? 'rd' : 'th';

                return formatted.replace(/(\d+)/, `$1${suffix}`);
            }

