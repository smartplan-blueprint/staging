        <!-- Delete Confirmation Modal -->
        <div id="deleteCreditLimitModal" class="delete_modal">
            <div class="delete_modal-content">
                <div class="delete_modal-header">
                    <h2>Delete Credit Limit</h2>
                    <span class="close-delete_modal">&times;</span>
                </div>
                <div class="delete_modal-body">
                    <p>Are you sure you want to delete this credit limit? This action cannot be undone.</p>

                    <div class="delete_provider-info">
                        <div class="delete_provider-info-item">
                            <span class="delete_provider-info-label">Amount:</span>
                            <span id="modalCreditAmount"></span>
                        </div>

                        <div class="delete_provider-info-item">
                            <span class="delete_provider-info-label">Expiry Date:</span>
                            <span id="modalExpiryDate"></span>
                        </div>

                        <div class="delete_provider-info-item">
                            <span class="delete_provider-info-label">Status:</span>
                            <span id="modalCreditStatus"></span>
                        </div>
                    </div>

{#                    <form id="deleteCreditLimitForm" method="POST" action="">#}
{#                        <input type="hidden" name="_token" value="{{ csrf_token('delete_credit_limit') }}">#}
{#                        <input type="hidden" name="_method" value="DELETE">#}
{#                        <input type="hidden" id="deleteLimitId" name="limitId">#}
{#                    </form>#}

                    <form id="deleteCreditLimitForm" method="POST" action="">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_credit_limit') }}">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" id="deleteLimitId" name="limitId" value="">
                    </form>
                </div>
                <div class="delete_modal-footer">
                    <button type="button" class="action-btn btn-secondary" id="cancelDelete">Cancel</button>
                    <button type="submit" form="deleteCreditLimitForm" class="action-btn btn-danger">Delete Permanently</button>
                </div>
            </div>
        </div>

        <div class="dashboard-container">
            <!-- Merchant Header -->
            <div class="dashboard-card">
                <div class="credit-limit-header">
                    <div class="header-content">
                        <h2 class="merchant-title">{{ app.user.merchant.name }}</h2>
                        <div class="merchant-id">Merchant ID: {{ app.user.merchant.code }}</div>
                    </div>

                    <div class="header-actions">
                        <button class="action-btn refresh-btn">
                            <i class="fas fa-sync-alt"></i> Refresh
                        </button>
                        <button class="action-btn export-btn">
                            <i class="fas fa-file-export"></i> Export
                        </button>
                    </div>
                </div>
            </div>

            <!-- Credit Limits -->
            <div class="dashboard-card">
                <div class="filter-container">
                    <div class="action-dropdown">
                        <select class="action-select" id="actionSelect">
                            <option value="">Filter By</option>
                            <option value="{{ path('app_limits_and_docs', {'id': merchant.id}) }}">Credit Limit</option>
                            <option value="{{ path('providers', {'id': merchant.id}) }}">Providers</option>
                            <option value="{{ path('merchant_commissions', {'id': merchant.id }) }}">Merchant Agreement</option>
                        </select>
                    </div>
                    <!--Credit Limit-->
                    <div class="dashboard-card">
                        <h3 style="margin-top: 0; color: var(--primary);">Credit Limit</h3>

                        <!-- Credit Limit Table -->
                        <table class="info-table">
                            <thead>
                            <tr>
                                <th>Date</th>
                                <th>Credit Amount (BWP)</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th>Authorized By</th>
                                <th>Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if credit_limits|length > 0 %}
                                {% for credit_limit in credit_limits %}
                                    <tr>
                                        <td>{{ credit_limit.dateApproved ? credit_limit.dateApproved|date('Y-m-d') : 'N/A' }}</td>
                                        <td>
                                            {% if filter_currency is defined %}
                                                {{ credit_limit.amount|format_bwp }}
                                            {% else %}
                                                P{{ credit_limit.amount|number_format(2, '.', ',') }}
                                            {% endif %}
                                        </td>
                                        <td>{{ credit_limit.expiryDate ? credit_limit.expiryDate|date('Y-m-d') : 'N/A' }}</td>
{#                                        <td>#}
{#                                            <span class="status-badge status-{{ credit_limit.status|lower|default('pending') }}">#}
{#                                                {{ credit_limit.status|default('Pending') }}#}
{#                                            </span>#}
{#                                        </td>#}
                                        <td>
                                            {% set status = credit_limit.status|default('Pending') %}
                                            {% set status_class = 'status-' ~ status|lower %}
                                            <span class="status-badge {{ status_class }}">{{ status }}</span>
                                        </td>
                                        <td>{{ credit_limit.authorizedBy|default('System') }}</td>
{#                                        <td>#}
{#                                            <a href="{{ path('app_limits_and_docs_edit', {'id': merchant.id, 'limitId': credit_limit.id}) }}"#}
{#                                               class="action-link edit-link">#}
{#                                                <i class="fas fa-edit"></i> Edit#}
{#                                            </a>#}
{#                                            <span class="action-separator">/</span>#}
{#                                            <a href="{{ path('app_limits_and_docs_remove', {'id': merchant.id, 'limitId': credit_limit.id}) }}"#}
{#                                               class="action-link remove-link"#}
{#                                               onclick="return confirm('Are you sure you want to remove this credit limit?');">#}
{#                                                <i class="fas fa-trash-alt"></i> Remove#}
{#                                            </a>#}
{#                                        </td>#}

                                        <td>
                                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
                                                <a href="#"
                                                   class="action-link edit-link"
                                                   onclick="showEditModal(
                                                   {{ credit_limit.id }},
                                                   {{ credit_limit.amount }},
                                                       '{{ credit_limit.expiryDate ? credit_limit.expiryDate|date('Y-m-d') }}',
                                                       '{{ credit_limit.status|default('Pending') }}'
                                                       ); return false;">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <span class="action-separator">/</span>
                                            {% endif %}
{#                                            <a href="{{ path('app_limits_and_docs_remove', {'id': merchant.id, 'limitId': credit_limit.id}) }}"#}
{#                                               class="action-link remove-link"#}
{#                                               onclick="return confirm('Are you sure you want to remove this credit limit?');">#}
{#                                                <i class="fas fa-trash-alt"></i> Remove#}
{#                                            </a>#}
                                            <a href="#"
                                               class="action-link remove-link"
                                               onclick="showDeleteModal(
                                               {{ credit_limit.id }},
                                               {{ credit_limit.amount }},
                                                   '{{ credit_limit.expiryDate ? credit_limit.expiryDate|date('Y-m-d') }}',
                                                   '{{ credit_limit.status|default('Pending') }}',
                                                   '{{ path('app_limits_and_docs_remove', {'merchantId': merchant.id, 'limitId': credit_limit.id}) }}'
                                                   ); return false;">
                                                <i class="fas fa-trash-alt"></i> Remove
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="no-records">
                                        <i class="fas fa-info-circle"></i> No credit limits found for this merchant
                                    </td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>

                        {% if credit_limits|length > 0 %}
                            <div class="table-footer">
                                <div class="table-summary">
                                    Total Credit:
                                    {% if filter_currency is defined %}
                                        {{ total_credit|format_bwp }}
                                    {% else %}
                                        P{{ total_credit|number_format(2, '.', ',') }}
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

