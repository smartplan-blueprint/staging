<div class="sidebar">
    <h2 class="sidebar-brand">Smart Plan Blueprint</h2>

    {# Get current merchant from session or user's merchant #}
    {% set current_merchant = app.session.get('current_merchant') ?? (app.user and app.user.merchant is defined ? app.user.merchant : null) %}

    {# Debug: Uncomment if needed to see what merchant is being used #}
    {# <div style="display: none;">Current Merchant ID: {{ current_merchant ? current_merchant.id : 'none' }}</div> #}

    {# Get current route for active link checking #}
    {% set current_route = app.request.get('_route') %}

    <a href="
