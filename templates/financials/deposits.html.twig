{#                            <tr>#}
{#                                <td>{{ dep.transactionDate ? dep.transactionDate|date('Y-m-d') : 'N/A' }}</td>#}
{#                                <td>{{ dep.merchantAccount ? dep.merchantAccount.accountName : 'N/A' }}</td>#}
{#                                <td>{{ dep.bank ? dep.bank.name : 'N/A' }}</td>#}
