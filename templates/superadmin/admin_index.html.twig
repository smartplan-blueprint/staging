{% extends 'superadmin_base.html.twig' %}

{% block title %}Merchants - Smart Plan Blueprint{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
{#            <h1>Merchant Management</h1>#}
            <div class="header-content">
                <h2 class="merchant-title">
                    {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_GROUP_ADMIN') %}
                        All Merchants Overview
                    {% else %}
                        {{ app.user.merchant.name }}
                    {% endif %}
                </h2>
                <div class="merchant-id">
                    {% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_GROUP_ADMIN') %}
                        Administrator View
                    {% else %}
                        Merchant ID: {{ app.user.merchant.code }}
                    {% endif %}
                </div>
            </div>
        </div>

        <a href="{{ path('app_merchant_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add New Merchant
        </a>
    </div>

    <!-- Dashboard Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title">{{ merchants|length }}</h3>
                            <p class="card-text mb-0">Total Merchants</p>
                        </div>
                        <i class="fas fa-store fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card stat-card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title">{{ merchants|filter(m => m.isActive)|length }}</h3>
                            <p class="card-text mb-0">Active Merchants</p>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card stat-card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title">{{ merchants|filter(m => not m.isActive)|length }}</h3>
                            <p class="card-text mb-0">Inactive Merchants</p>
                        </div>
                        <i class="fas fa-ban fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card stat-card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title">{{ merchants|filter(m => m.registrationDate|date('Y-m-d') == 'now'|date('Y-m-d'))|length }}</h3>
                            <p class="card-text mb-0">New Today</p>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Merchant-ID</th>
                        <th>Client ID</th>
                        <th>Registration Date</th>
                        <th>Status</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for merchant in merchants %}
                        <tr>
                            <td>{{ merchant.name }}</td>
                            <td>{{ merchant.code }}</td>
                            <td>{{ merchant.clientId }}</td>
                            <td>{{ merchant.registrationDate|date('Y-m-d') }}</td>
                            <td>
                            <span class="{{ merchant.isActive ? 'status-active' : 'status-inactive' }}">
                                {{ merchant.isActive ? 'Active' : 'Inactive' }}
                            </span>
                            </td>
                            <td>
                                {{ merchant.merchantDetails.contactName ?? 'Not provided' }}<br>
                                <small class="text-muted">{{ merchant.merchantDetails.contactEmail ?? 'No email' }}</small>
                            </td>

                            <td>
                                <div class="btn-group">
                                    <a href="{{ path('app_merchant_view', {'id': merchant.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_merchant_edit', {'id': merchant.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_merchant_toggle_status', {'id': merchant.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ merchant.id) }}">
                                        <button type="submit" class="btn btn-sm {{ merchant.isActive ? 'btn-warning' : 'btn-success' }}">
                                            <i class="fas {{ merchant.isActive ? 'fa-ban' : 'fa-check' }}"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('app_merchant_delete', {'id': merchant.id}) }}" onsubmit="return confirm('Are you sure you want to delete this merchant?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ merchant.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">No merchants found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
