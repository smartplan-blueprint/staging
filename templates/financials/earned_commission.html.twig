{% extends 'base.html.twig' %}

{% block title %}Financial Details - PrepaidPlus{% endblock %}

{% block header_title %}Financials Overview{% endblock %}

{% block breadcrumb %}
    <div class="breadcrumb-item">
        <a href="{{ path('app_financials', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Financials</a>
        <span class="breadcrumb-separator">/</span>
        <a href="{{ path('financials_commission', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Commission</a>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .merchant-container {
            margin: 0 auto;
            padding: 20px;
        }

        .info-card {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .info-table th {
            text-align: left;
            padding: 12px;
            background-color: var(--light);
            border-bottom: 2px solid #bdc3c7;
        }

        .info-table td {
            padding: 12px;
            border-bottom: 1px solid var(--light);
        }


        /* Enhanced Dropdown Styles */
        .action-dropdown {
            position: relative;
            display: inline-block;
            margin-bottom: 20px;
        }

        .action-select {
            padding: 8px 15px;
            border-radius: 4px;
            border: 1px solid #ddd;
            background-color: white;
            cursor: pointer;
            min-width: 150px;
        }

        .action-select:focus {
            outline: none;
            border-color: var(--primary);
        }

        .header-content {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .merchant-title {
            margin: 0;
            color: var(--primary);
            font-size: 1.5rem;
            font-weight: 600;
        }

        .merchant-id {
            color: var(--gray);
            font-size: 0.9rem;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="merchant-container">
        <div class="dashboard-container">
            <!-- Merchant Header -->
            <div class="dashboard-card">
                <div class="header-content">
                    <h2 class="merchant-title">{{ app.user.merchant.name }}</h2>
                    <div class="merchant-id">Merchant ID: {{ app.user.merchant.code }}</div>
                </div>

                <!-- Dates -->
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <span style="font-weight: bold; color: var(--gray);">Date Range:</span>
                        <span style="margin-left: 10px;" id="dateRangeDisplay">
                        {{ dateRange.display }}
                    </span>
                    </div>
                    <div id="date-range" style="display: flex; gap: 10px;">

                        <a href="{{ path('financials_earned_commission', {'id': merchant.id, 'range': 'today'}) }}"
                           style="padding: 8px 15px; {{ dateRange.currentRange == 'today' ? 'background-color: var(--secondary); color: white;' : 'background-color: var(--light);' }} border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center;">
                            Today
                        </a>
                        <a href="{{ path('financials_earned_commission', {'id': merchant.id, 'range': 'week'}) }}"
                           style="padding: 8px 15px; {{ dateRange.currentRange == 'week' ? 'background-color: var(--secondary); color: white;' : 'background-color: var(--light);' }} border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center;">
                            Last 7 Days
                        </a>
                        <a href="{{ path('financials_earned_commission', {'id': merchant.id, 'range': 'month'}) }}"
                           style="padding: 8px 15px; {{ dateRange.currentRange == 'month' ? 'background-color: var(--secondary); color: white;' : 'background-color: var(--light);' }} border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center;">
                            Month to Date
                        </a>
                    </div>
                </div>
            </div>

            <!-- Metrics Grid -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 20px;">
                <div class="dashboard-card metric-card sales">
                    <div style="color: var(--gray); font-size: 14px;">SALES</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P{{ metricTotals.sales|number_format(2) }}</div>
                </div>

                <div class="dashboard-card metric-card commission">
                    <div style="color: var(--gray); font-size: 14px;">COMMISSION</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P0.00</div>
                </div>

                <div class="dashboard-card metric-card deposits">
                    <div style="color: var(--gray); font-size: 14px;">DEPOSITS</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P{{ metricTotals.deposits|number_format(2) }}</div>
                </div>

                <div class="dashboard-card metric-card closing">
                    <div style="color: var(--gray); font-size: 14px;">REVERSALS FOR PERIOD</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P{{ metricTotals.reversals|number_format(2) }}</div>
                </div>
            </div>


            <!-- Financials -->
            <div class="dashboard-card">

                <div class="action-dropdown">
                    <select class="action-select" id="actionSelect" onchange="handleFilterChange(this)">
                        <option value="">Filter By</option>
                        <option value="{{ path('app_financials', {'id': merchant.id}) }}" selected>Sales</option>
                        <option value="{{ path('financials_commission', {'id': merchant.id}) }}">Commission</option>
                        <option value="{{ path('financials_deposits', {'id': merchant.id}) }}">Deposits</option>
                        <option value="{{ path('financials_reversals', {'id': merchant.id}) }}">Reversals</option>
                        <option value="{{ path('financials_withdrawals', {'id': merchant.id}) }}">Withdrawals</option>
                        <option value="{{ path('financials_transfers', {'id': merchant.id}) }}">Transfers</option>
                        <option value="{{ path('financials_summary', {'id': merchant.id}) }}">Summary</option>
                    </select>
                </div>

                <!--Commission-->
                <div class="dashboard-card">

                    <div class="info-card">
                        <h3 style="margin-top: 0; color: var(--primary);">Commission (Earned)</h3>

                        <div class="breadcrumb-item">
                            <a href="{{ path('financials_commission', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Credited</a>
                            <span class="breadcrumb-separator">/</span>
                            <a href="{{ path('financials_earned_commission', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Earned</a>
                        </div>
                    </div>

                    <!--Commission Table-->
                    <table class="info-table">
                        <thead>
                        <tr>
                            <th>Type</th>
                            <th>Provider</th>
                            <th>Rate</th>
                            <th>Sales</th>
                            <th>Merchant</th>

                        </tr>
                        </thead>
                        <tbody>
                        {% for comm in earnedCommission %}
                            <tr>
                                <td>{{ comm.Type }}</td>
                                <td>{{ comm.Provider }}</td>
                                <td>{{ comm.Rate|format_percent }}</td>
                                <td>{{ comm.Sales|format_bwp }}</td>
                                <td>{{ comm.Merchant|format_bwp }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center">No commission records found</td>
                            </tr>
                        {% endfor %}

                        {% if commission|length > 0 %}
                            <tr class="total-row">
                                <td><strong>Total</strong></td>
                                <td></td>
                                <td></td>
                                <td><strong>P{{ commission|reduce((sum, item) => sum + item.Sales, 0)|number_format(2) }}</strong></td>
                                <td><strong>P{{ commission|reduce((sum, item) => sum + item.Merchant, 0)|number_format(2) }}</strong></td>
                            </tr>
                        {% endif %}

                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    {% block javascripts %}
        {{ parent() }}

        <script>
            function setDateRange(range) {
                const today = new Date();
                let startDate, endDate;

                switch(range) {
                    case 'today':
                        startDate = new Date(today);
                        endDate = new Date(today);
                        break;
                    case 'week':
                        startDate = new Date(today);
                        startDate.setDate(today.getDate() - 6); // Last 7 days (including today)
                        endDate = new Date(today);
                        break;
                    case 'month':
                        startDate = new Date(today.getFullYear(), today.getMonth(), 1); // First day of current month
                        endDate = new Date(today);
                        break;
                }

                // Format dates for display
                const formattedStart = formatDate(startDate);
                const formattedEnd = formatDate(endDate);

                // Update the display
                document.getElementById('dateRangeDisplay').textContent =
                    formattedStart === formattedEnd
                        ? formattedStart
                        : `${formattedStart} - ${formattedEnd}`;

            }

            function formatDate(date) {
                const options = {
                    month: 'long',
                    day: 'numeric',
                    year: date.getMonth() !== new Date().getMonth() ? 'numeric' : undefined
                };

                let formatted = date.toLocaleDateString('en-US', options);

                // Add ordinal suffix (1st, 2nd, 3rd, 4th)
                const day = date.getDate();
                const suffix = (day % 10 === 1 && day !== 11) ? 'st' :
                    (day % 10 === 2 && day !== 12) ? 'nd' :
                        (day % 10 === 3 && day !== 13) ? 'rd' : 'th';

                return formatted.replace(/(\d+)/, `$1${suffix}`);
            }

            // Initialize with today's date
            document.addEventListener('DOMContentLoaded', function() {
                setDateRange('today');

                document.getElementById('actionSelect').addEventListener('change', function() {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            });
        </script>
    {% endblock %}
{% endblock %}
