        {# In your base.html.twig #}
        <!-- Profile Icon -->
        <div class="icon-wrapper">
            <i class="fas fa-user-circle" id="profile-icon" title="Profile"></i>
            <div class="dropdown" id="profile-dropdown">
                <div class="dropdown-header">
                    <span>User Profile</span>
                </div>
                <div class="dropdown-content">
                    <div class="dropdown-item user-info">
                        <div class="user-avatar">
                            <i class="fas fa-user-circle fa-2x"></i>
                        </div>
                        <div class="user-details">
                            <strong>
                                {% if app.user %}
                                    {# Try to detect if it's your custom User entity #}
                                    {% if app.user.merchant is defined %}
                                        {{ app.user.firstName }} {{ app.user.lastName }}
                                    {% else %}
                                        {# It's InMemoryUser - use getUserIdentifier #}
                                        {{ app.user.userIdentifier|split('@')[0]|capitalize }}
                                    {% endif %}
                                {% else %}
                                    Guest User
                                {% endif %}
                            </strong>
                            <small>
                                {% if app.user %}
                                    {{ app.user.userIdentifier }}
                                {% else %}
                                    Not available
                                {% endif %}
                            </small>
                            <small>
                                Role:
                                {% if app.user and app.user.roles[0] is defined %}
                                    {{ app.user.roles[0]|replace({'ROLE_': ''})|lower|capitalize }}
                                {% else %}
                                    Guest
                                {% endif %}
                            </small>
                        </div>
                    </div>

                    {% if app.user %}
                        {# Only show profile links for custom User entities #}
                        {% if app.user.merchant is defined %}
                            <a href="{{ path('app_profile_view') }}" class="dropdown-item">
                                <i class="fas fa-user"></i>
                                <span>View Profile</span>
                            </a>
                            <a href="{{ path('app_profile_edit') }}" class="dropdown-item">
                                <i class="fas fa-edit"></i>
                                <span>Edit Profile</span>
                            </a>
                            <a href="{{ path('app_settings_security') }}" class="dropdown-item">
                                <i class="fas fa-lock"></i>
                                <span>Change Password</span>
                            </a>
                        {% endif %}
                        <div class="dropdown-item">
                            <i class="fas fa-sign-out-alt"></i>
                            <a href="{{ path('app_logout') }}" class="logout-link">Logout</a>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="dropdown-item">
                            <i class="fas fa-sign-in-alt"></i>
