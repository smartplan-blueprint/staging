{% extends 'base.html.twig' %}

{% block title %}Limits & Documents - PrepaidPlus{% endblock %}

{% block header_title %}Limits & Documents Overview{% endblock %}

{% block breadcrumb %}
    <div class="breadcrumb-item">
        <a href="{{ path('app_limits_and_docs', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Limits&Docs</a>
        <span class="breadcrumb-separator">/</span>
        <a href="{{ path('providers', {'id': merchant.id}) }}" style="color: #7f8c8d;" class="breadcrumb-link">Providers</a>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .merchant-container {
            margin: 0 auto;
            padding: 20px;
        }

        .info-table th {
            text-align: left;
            padding: 12px;
            background-color: var(--light);
            border-bottom: 2px solid #bdc3c7;
        }

        .info-table td {
            padding: 12px;
            border-bottom: 1px solid var(--light);
        }


