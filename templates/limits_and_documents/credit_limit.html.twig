            // Delete Modal Functions
            const deleteModal = document.getElementById('deleteCreditLimitModal');
            const closeModalBtn = document.querySelector('#deleteCreditLimitModal .close-delete_modal');
            const cancelDeleteBtn = document.getElementById('cancelDelete');

            function showDeleteModal(limitId, amount, expiryDate, status, deleteUrl) {
                // Set modal content
                document.getElementById('modalCreditAmount').textContent = 'P' + amount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                document.getElementById('modalExpiryDate').textContent = expiryDate || 'N/A';
                document.getElementById('modalCreditStatus').innerHTML =
                    `<span class="status-badge status-${status.toLowerCase()}">${status}</span>`;

                // Set form values
                document.getElementById('deleteLimitId').value = limitId;
                document.getElementById('deleteCreditLimitForm').action = deleteUrl;

                // Show modal
                deleteModal.style.display = 'block';
            }

            function closeDeleteModal() {
                deleteModal.style.display = 'none';
            }

            // Event listeners for modal close
            closeModalBtn.addEventListener('click', closeDeleteModal);
            cancelDeleteBtn.addEventListener('click', closeDeleteModal);

            // Close when clicking outside modal
            window.addEventListener('click', function(event) {
                if (event.target === deleteModal) {
                    closeDeleteModal();
                }
            });

            // Handle form submission
            document.getElementById('deleteCreditLimitForm').addEventListener('submit', function(e) {
                e.preventDefault();

                const form = this;
                const formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            return response.json();
                        }
                    })
                    .then(data => {
                        if (data && data.success) {
                            // Reload the page or remove the row from table
                            window.location.reload();
                        } else {
                            alert('Error deleting credit limit: ' + (data.message || 'Unknown error'));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred while deleting the credit limit');
                    });
            });

