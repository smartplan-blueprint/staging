{% extends 'base.html.twig' %}

{% block title %}Financial Details - PrepaidPlus{% endblock %}

{% block header_title %}Financials Overview{% endblock %}

{% block breadcrumb %}
    <div class="breadcrumb-item">
        <a href="{{ path('app_financials') }}" style="color: #7f8c8d;" class="breadcrumb-link">Financials</a>
        <span class="breadcrumb-separator">/</span>
        <a href="{{ path('financials_transfers') }}" style="color: #7f8c8d;" class="breadcrumb-link">Transfers</a>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .merchant-container {
            margin: 0 auto;
            padding: 20px;
        }

        .info-table th {
            text-align: left;
            padding: 12px;
            background-color: var(--light);
            border-bottom: 2px solid #bdc3c7;
        }

        .info-table td {
            padding: 12px;
            border-bottom: 1px solid var(--light);
        }


        /* Enhanced Dropdown Styles */
        .action-dropdown {
            position: relative;
            display: inline-block;
            margin-bottom: 20px;
        }

        .action-select {
            padding: 8px 15px;
            border-radius: 4px;
            border: 1px solid #ddd;
            background-color: white;
            cursor: pointer;
            min-width: 150px;
        }

        .action-select:focus {
            outline: none;
            border-color: var(--primary);
        }

        .header-content {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .merchant-title {
            margin: 0;
            color: var(--primary);
            font-size: 1.5rem;
            font-weight: 600;
        }

        .merchant-id {
            color: var(--gray);
            font-size: 0.9rem;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="merchant-container">
        <div class="dashboard-container">
            <!-- Merchant Header -->
            <div class="dashboard-card">
                <div class="header-content">
                    <h2 class="merchant-title">Smart Plan Blueprint</h2>
                    <div class="merchant-id">Merchant ID: 3928</div>
                </div>

                <!--Dates-->
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <span style="font-weight: bold; color: var(--gray);">Date Range:</span>
                        <span style="margin-left: 10px;" id="dateRangeDisplay">
            {{ 'now'|date('F jS') }} - {{ 'now'|date('F jS, Y') }}
        </span>
                    </div>
                    <div id="date-range" style="display: flex; gap: 10px;">
                        <button onclick="setDateRange('today')" style="padding: 8px 15px; background-color: var(--secondary); color: white; border: none; border-radius: 4px; cursor: pointer;">Today</button>
                        <button onclick="setDateRange('week')" style="padding: 8px 15px; background-color: var(--light); border: none; border-radius: 4px; cursor: pointer;">Last 7 Days</button>
                        <button onclick="setDateRange('month')" style="padding: 8px 15px; background-color: var(--light); border: none; border-radius: 4px; cursor: pointer;">Month to Date</button>
                    </div>
                </div>
            </div>

            <!-- Metrics Grid -->
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 20px;">
                <div class="dashboard-card metric-card opening">
                    <div style="color: var(--gray); font-size: 14px;">SALES</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P0.00</div>
                </div>

                <div class="dashboard-card metric-card deposits">
                    <div style="color: var(--gray); font-size: 14px;">COMMISSION</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P0.00</div>
                </div>

                <div class="dashboard-card metric-card sales">
                    <div style="color: var(--gray); font-size: 14px;">DEPOSITS</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P0.00</div>
                </div>

                <div class="dashboard-card metric-card commission">
                    <div style="color: var(--gray); font-size: 14px;">REVERSALS FOR PERIOD</div>
                    <div style="font-size: 24px; font-weight: bold; color: var(--dark);">P0.00</div>
                </div>
            </div>


            <!-- Financials -->
            <div class="dashboard-card">

                <div class="action-dropdown">
                    {# Get the current merchant ID from URL parameters or session #}
                    {% set current_merchant_id = app.request.get('id') ?? (app.session.get('current_merchant') ? app.session.get('current_merchant').id : (merchant is defined ? merchant.id : null)) %}

                    <select class="action-select" id="actionSelect" onchange="handleFilterChange(this)">
                        <option value="">Filter By</option>
                        <option value="{{ path('app_financials', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'app_financials' ? 'selected' : '' }}>Sales</option>
                        <option value="{{ path('financials_commission', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_commission' ? 'selected' : '' }}>Commission</option>
                        <option value="{{ path('financials_deposits', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_deposits' ? 'selected' : '' }}>Deposits</option>
                        <option value="{{ path('financials_reversals', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_reversals' ? 'selected' : '' }}>Reversals</option>
                        <option value="{{ path('financials_withdrawals', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_withdrawals' ? 'selected' : '' }}>Withdrawals</option>
                        <option value="{{ path('financials_transfers', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_transfers' ? 'selected' : '' }}>Transfers</option>
                        <option value="{{ path('financials_summary', {'id': current_merchant_id}) }}" {{ app.request.attributes.get('_route') == 'financials_summary' ? 'selected' : '' }}>Summary</option>
                    </select>
                </div>

                <!--Transfers-->
                <div class="dashboard-card">
                    <h3 style="margin-top: 0; color: var(--primary);">Transfers</h3>
                </div>

            </div>
        </div>
    </div>

    {% block javascripts %}
        {{ parent() }}

        <script>
            function setDateRange(range) {
                const today = new Date();
                let startDate, endDate;

                switch(range) {
                    case 'today':
                        startDate = new Date(today);
                        endDate = new Date(today);
                        break;
                    case 'week':
                        startDate = new Date(today);
                        startDate.setDate(today.getDate() - 6); // Last 7 days (including today)
                        endDate = new Date(today);
                        break;
                    case 'month':
                        startDate = new Date(today.getFullYear(), today.getMonth(), 1); // First day of current month
                        endDate = new Date(today);
                        break;
                }

                // Format dates for display
                const formattedStart = formatDate(startDate);
                const formattedEnd = formatDate(endDate);

                // Update the display
                document.getElementById('dateRangeDisplay').textContent =
                    formattedStart === formattedEnd
                        ? formattedStart
                        : `${formattedStart} - ${formattedEnd}`;

                // Here you would typically reload data from the server
                // fetchDashboardData(startDate, endDate);
            }

            function formatDate(date) {
                const options = {
                    month: 'long',
                    day: 'numeric',
                    year: date.getMonth() !== new Date().getMonth() ? 'numeric' : undefined
                };

                let formatted = date.toLocaleDateString('en-US', options);

                // Add ordinal suffix (1st, 2nd, 3rd, 4th)
                const day = date.getDate();
                const suffix = (day % 10 === 1 && day !== 11) ? 'st' :
                    (day % 10 === 2 && day !== 12) ? 'nd' :
                        (day % 10 === 3 && day !== 13) ? 'rd' : 'th';

                return formatted.replace(/(\d+)/, `$1${suffix}`);
            }

            // Initialize with today's date
            document.addEventListener('DOMContentLoaded', function() {
                setDateRange('today');

                document.getElementById('actionSelect').addEventListener('change', function() {
                    if (this.value) {
                        window.location.href = this.value;
                    }
                });
            });

            function handleFilterChange(selectElement) {
                if (selectElement.value) {
                    window.location.href = selectElement.value;
                }
            }
            // Initialize with today's date
            document.addEventListener('DOMContentLoaded', function() {
                setDateRange('today');
            });

            document.getElementById('actionSelect').addEventListener('change', function() {
                if (this.value) {
                    window.location.href = this.value;
                }
            });
        </script>
    {% endblock %}
{% endblock %}
