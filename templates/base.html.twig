{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // API endpoints
        const SEARCH_API_URL = "{{ path('api_search') }}";
        const SEARCH_HISTORY_URL = "{{ path('api_search_history') }}";
        const SEARCH_RESULTS_URL = "{{ path('app_search_results') }}";
        const THEME_CHANGE_URL = "{{ path('app_settings_theme') }}";

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all icon dropdowns
            const iconWrappers = document.querySelectorAll('.icon-wrapper');

            iconWrappers.forEach(wrapper => {
                const icon = wrapper.querySelector('i');
                const dropdown = wrapper.querySelector('.dropdown');

                if (icon && dropdown) {
                    // Toggle dropdown on icon click
                    icon.addEventListener('click', function(e) {
                        e.stopPropagation();

                        // Close all other dropdowns
                        document.querySelectorAll('.dropdown').forEach(d => {
                            if (d !== dropdown) {
                                d.style.display = 'none';
                            }
                        });

                        // Toggle current dropdown
                        dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
                    });

                    // Prevent dropdown from closing when clicking inside
                    dropdown.addEventListener('click', function(e) {
                        e.stopPropagation();
                    });
                }
            });

            // Close dropdowns when clicking outside
            document.addEventListener('click', function() {
                document.querySelectorAll('.dropdown').forEach(dropdown => {
                    dropdown.style.display = 'none';
                });
            });

            // Search functionality
            const searchIcon = document.getElementById('search-icon');
            const searchDropdown = document.getElementById('search-dropdown');
            const searchInput = document.getElementById('search-input');
            const recentSearchesContainer = document.getElementById('recent-searches');

            // Toggle dropdown visibility
            if (searchIcon && searchDropdown) {
                searchIcon.addEventListener('click', function() {
                    searchDropdown.style.display = searchDropdown.style.display === 'block' ? 'none' : 'block';
                    if (searchDropdown.style.display === 'block') {
                        searchInput.focus();
                        loadRecentSearches();
                    }
                });
            }

            // Search as you type with debounce
            let searchTimeout;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    const query = searchInput.value.trim();

                    if (query.length > 2) {
                        searchTimeout = setTimeout(() => {
                            performSearch(query);
                        }, 500);
                    }
                });
            }

            // Load recent searches from API
            async function loadRecentSearches() {
                if (!recentSearchesContainer) return;

                try {
                    const response = await fetch(SEARCH_HISTORY_URL, {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        credentials: 'include'
                    });

                    if (response.status === 401) {
                        recentSearchesContainer.innerHTML = '<div class="dropdown-item"><span>Please login to view search history</span></div>';
                        return;
                    }

                    if (!response.ok) {
                        throw new Error('Failed to fetch search history');
                    }

                    const data = await response.json();
                    recentSearchesContainer.innerHTML = '';

                    if (!data.history || data.history.length === 0) {
                        const noRecentItem = document.createElement('div');
                        noRecentItem.className = 'dropdown-item';
                        noRecentItem.innerHTML = '<span>No recent searches</span>';
                        recentSearchesContainer.appendChild(noRecentItem);
                        return;
                    }

                    data.history.forEach(search => {
                        const searchItem = document.createElement('div');
                        searchItem.className = 'dropdown-item recent-search';
                        searchItem.innerHTML = `
                            <div>
                                <i class="fas fa-search"></i>
                                <span>${search.query}</span>
                            </div>
                        `;

                        // Add click event to recent search item
                        searchItem.addEventListener('click', function() {
                            if (searchInput) searchInput.value = search.query;
                            performSearch(search.query);
                        });

                        recentSearchesContainer.appendChild(searchItem);
                    });
                } catch (error) {
                    console.error('Error loading search history:', error);
                    recentSearchesContainer.innerHTML = '<div class="dropdown-item"><span>Error loading history</span></div>';
                }
            }

            // Perform search
            async function performSearch(query) {
                if (query.length < 3) return;

                try {
                    const response = await fetch(SEARCH_API_URL, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ query: query }),
                        credentials: 'include'
                    });

                    if (response.status === 401) {
                        window.location.href = '/login';
                        return;
                    }

                    if (!response.ok) {
                        throw new Error('Search request failed');
                    }

                    // Redirect to search results page
                    window.location.href = SEARCH_RESULTS_URL + "?q=" + encodeURIComponent(query);
                } catch (error) {
                    console.error('Search error:', error);
                }
            }

            // Highlight current page in sidebar
            const currentRoute = "{{ app.request.get('_route') }}";
            const sidebarItems = document.querySelectorAll('.sidebar-item');

            sidebarItems.forEach(item => {
                item.classList.remove('active');
                if (item.getAttribute('href') === window.location.pathname) {
                    item.classList.add('active');
                }
            });
        });

        // Theme change functionality
        function changeTheme(theme) {
            fetch(THEME_CHANGE_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ theme: theme }),
                credentials: 'include'
            }).then(response => {
                if (response.ok) {
                    location.reload();
                }
            });
        }
    </script>
{% endblock %}
</body>
</html>
